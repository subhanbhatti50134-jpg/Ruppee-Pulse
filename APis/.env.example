# Copy to .env and adjust if needed (all values have working defaults).

# Port the backend listens on (uvicorn flag: --port)
# RP_PORT=8010

# Browser origins allowed by CORS
RP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AES-256 master key for API-key encryption.
# Auto-generated into data/master.key when omitted — keep that file private.
# RP_MASTER_KEY=

# Comma-separated spot symbols tracked over the Binance WebSocket
RP_SYMBOLS=BTC,ETH,BNB,SOL,XRP,DOGE,ADA,TRX,AVAX,LINK,DOT,LTC,BCH,UNI,XLM,POL

# P2P aggregator refresh cadence (seconds)
RP_P2P_REFRESH_SECONDS=60

# Interbank USD/PKR refresh cadence (seconds)
RP_FX_REFRESH_SECONDS=3600

# Premium moving-average window (points) and auto-alert deviation (percentage points)
RP_PREMIUM_MA_WINDOW=30
RP_PREMIUM_MA_DEVIATION_PCT=1.5

# Starting balance for new demo (paper) accounts, in USDT
RP_DEMO_BALANCE=100000

# Phase 2: arbitrage scanner threshold — minimum cross-method round-trip
# margin (%) before an arbitrage alert fires
RP_ARB_MARGIN_PCT=1.0

# Telegram alerts (optional). Create a bot via @BotFather, get your chat id
# from @userinfobot, then POST /api/telegram/test to verify.
# RP_TELEGRAM_BOT_TOKEN=
# RP_TELEGRAM_CHAT_ID=

# Shared cache (optional). Set to a Redis URL to share cached market/P2P data
# across processes; anything unreachable or unset falls back to the built-in
# in-memory TTL cache automatically. docker-compose sets this for you.
# RP_REDIS_URL=redis://localhost:6379/0
